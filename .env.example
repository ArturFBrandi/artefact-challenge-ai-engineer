# --- LLM (MiniMax-M3 is the system's only reasoning LLM) ---
LLM_PROVIDER=minimax
# Create a key at https://platform.minimax.io
LLM_API_KEY=
LLM_BASE_URL=https://api.minimax.io/v1
LLM_MODEL=MiniMax-M3
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# Maximum tokens generated per call, thinking included
LLM_MAX_COMPLETION_TOKENS=4096
# adaptive = model decides; disabled = skip thinking
LLM_THINKING=adaptive
# USD per million tokens, used only to report cost
LLM_PRICE_INPUT_PER_MTOK=0.30
LLM_PRICE_OUTPUT_PER_MTOK=1.20

# --- Agent ---
MAX_TOOL_ROUNDS=6
MEMORY_WINDOW_TURNS=12
# Minutes of inactivity before a verified customer must verify again
VERIFICATION_TTL_MINUTES=30

# --- Storage ---
DB_PATH=var/emporio.db
TRACE_DIR=var/traces

# --- Clock ---
STORE_TIMEZONE=America/Campo_Grande
# The newest order is from 2026-03-22, so demos freeze the clock just after it.
# Leave blank to use the real clock.
STORE_NOW=2026-03-25T10:00:00-04:00

# --- Web ---
WEB_HOST=127.0.0.1
WEB_PORT=8000
LOG_LEVEL=INFO
